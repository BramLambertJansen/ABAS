    "^scripts/check-",
    "^scripts/lib/",
    "^scripts/kit/",
    "^\\.github/",
    "^\\.claude/",
    "^\\.husky/",
    "^\\.kit/",
    "^eslint\\.config\\.",
    "^tsconfig.*\\.json$",
    "^playwright\\.config\\.",
    "^CLAUDE\\.md$",
    "^eslint-suppressions\\.json$",
    "^next\\.config\\.",
    "^vercel\\.json$",
    "^osv-scanner\\.toml$",
    "^AGENTS\\.md$",
    "^\\.betterleaks",
    "^\\.git(?:/|$)",
    "^\\.gitleaks"
  ],
  "testpaden": [
    "^supabase/tests/",
    "^test/",
    "^e2e/",
    "^integration/"
  ],
  "goedkeurders": [
    "BramLambertJansen"
  ],
  "jsonGates": {
    "package.json": [
      "scripts"
    ]
  },
  "schrijfrecht": {
    "architect": [
      "^docs/features/",
      "^docs/adr/",
