{
  "name": "abas",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check:arch": "node scripts/check-arch.mjs",
    "check:policy": "node scripts/check-policy.mjs",
    "check:rls": "node scripts/check-rls.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:adr": "node scripts/check-adr.mjs",
    "check:a11y": "playwright test",
    "db:test": "supabase test db",
    "test:integration": "node --test \"integration/**/*.test.ts\"",
    "check:fast": "npm run lint && npm run typecheck && npm run test && npm run check:arch && npm run check:policy && npm run check:rls && npm run check:migrations && npm run check:adr",
    "check:all": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:arch && npm run check:policy && npm run check:rls && npm run check:migrations && npm run check:adr && npm run check:a11y && npm run db:test && npm run test:integration",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
