{
  "name": "abas",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "check:arch": "node scripts/check-arch.mjs",
    "check:policy": "node scripts/check-policy.mjs",
    "check:rls": "node scripts/check-rls.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:adr": "node scripts/check-adr.mjs",
    "check:catalogus": "node scripts/kit/systeem.mjs",
    "check:axe": "node scripts/kit/axe.mjs",
    "check:a11y": "playwright test",
    "db:test": "supabase test db",
    "test:integration": "node --test \"integration/**/*.test.ts\"",
    "check:fast": "npm run lint && npm run typecheck && npm run test && npm run check:arch && npm run check:policy && npm run check:rls && npm run check:migrations && npm run check:adr && npm run check:catalogus && npm run check:axe && npm run check:docs",
    "check:all": "npm run check:fast && npm run check:slow",
    "prepare": "node .husky/install.mjs",
    "check:deployment": "node scripts/check-deployment-schema.mjs",
    "lint:prune": "eslint . --prune-suppressions",
    "ratchet:update": "RATCHET_UPDATE=1 npm run check:rls && RATCHET_UPDATE=1 npm run check:catalogus && RATCHET_UPDATE=1 npm run check:axe && RATCHET_UPDATE=1 npm run check:docs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:slow": "npm run check:deployment && npm run build && npm run db:test && npm run test:integration && npm run check:a11y"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "axe-core": "^4.13.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.27",
    "eslint-plugin-better-tailwindcss": "4.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.29"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
