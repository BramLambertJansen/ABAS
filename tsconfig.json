{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    // ADR 0025: index-toegang geeft T | undefined in productiecode. Tests
    // (tsconfig.tests.json) zetten dit uit; zij falen toch al hard.
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // test/ draait op Node's ingebouwde runner met native
    // type-stripping, die geen extensieloze TS-imports oplost — de
    // testbestanden importeren daarom "../src/....ts" letterlijk.
    // Alleen toegestaan naast noEmit, wat hierboven al staat.
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "test", "e2e", "integration", "playwright.config.ts"]
}
